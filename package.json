{
  "name": "frame-movie-platform",
  "version": "1.0.0",
  "description": "Single-origin movie platform API and React client",
  "main": "backend/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev:server": "nodemon backend/server.js",
    "dev:client": "npm --prefix frontend-files run dev",
    "build": "npm --prefix frontend-files run build",
    "init-db": "node backend/initDatabase.js",
    "create-admin": "node backend/createAdmin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
